{
  "name": "dxos-echo-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Realtime collaborative editing demo \u2014 two windows, one CRDT document, live coloured carets.",
  "scripts": {
    "dev": "concurrently -k -n relay,vite -c magenta,cyan \"node --disable-warning=ExperimentalWarning server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "vite build && node --disable-warning=ExperimentalWarning server/index.js",
    "serve": "node --disable-warning=ExperimentalWarning server/index.js",
    "bench": "node --disable-warning=ExperimentalWarning bench/load.js",
    "test": "node --disable-warning=ExperimentalWarning --test --test-timeout=60000 test/*.js",
    "build:pages": "VITE_RELAY=wss://demos.yjs.dev/ws vite build"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "codemirror": "^6.0.2",
    "lib0": "^0.2.117",
    "ws": "^8.21.3",
    "y-codemirror.next": "^0.3.6",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "vite": "^8.2.1"
  },
  "license": "MIT",
  "homepage": "https://dxos.akeyo.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/fire17/EchoCollab"
  }
}
